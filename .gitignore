*.rbxl
*.rbxl.lock
*.rbxlx.lock
sourcemap.json
Packages/
ServerPackages/
*.rbxlx
.superpowers/
*.blend1
*.fbm/
__pycache__/

# Fonts for the texture scripts (fetched locally; see tools/textures/make_pack_textures.py)
tools/textures/fonts/

# Playwright MCP browser scratch (screenshots and page dumps)
.playwright-mcp/
# Leftovers from making models: preview-build palettes, and concept sheets before processing (the processed
# <Name>_sheet.png is kept)
assets/blender/*_prev/
assets/blender/*/*_sheet_raw.png
assets/blender/*/*_sheet_preview.jpg

# Weapons (tools/blender/weapon_kit.py): the raw Meshy models and the Figma concepts stay local
assets/blender/*/*_raw.glb
assets/blender/*/concept_*.png
# A remake's concept picks and their neutral-pose redraws for Meshy, and the rig scripts' test pose renders (POSES=1)
assets/blender/*/*_concept_*.png
assets/blender/*/*_neutral_*.png
assets/blender/*/poses/
assets/blender/*/poses_sheet.png
# Reference photos for a model (the owner's own pictures, e.g. Pish) stay local too
assets/blender/*/reference_*.png
assets/ui/covers/options/

# Imported prop packs before tools/props/split_pack splits them into assets/props (not synced)
assets/props-import/
